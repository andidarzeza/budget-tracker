# Copy to `.env` next to docker-compose.yml. Never commit `.env` (it is git-ignored).

# Signs login tokens. 32+ random characters, e.g. the output of: openssl rand -base64 48
# Changing it signs everyone out.
JWT_SECRET=

# Optional: ports the server's nginx proxies to (both bound to 127.0.0.1).
WEB_PORT=4001
BACKEND_PORT=9000
